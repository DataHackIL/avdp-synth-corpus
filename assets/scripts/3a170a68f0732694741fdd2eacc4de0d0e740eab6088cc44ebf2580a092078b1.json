        {
          "char_end_original": 209,
          "char_start_original": 165,
          "hint": "stress",
          "phrase_id": "t7_p1"
        }
      ],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05d9? \u05d0\u05ea \u05e6\u05d5\u05d7\u05e7\u05ea \u05e2\u05dc\u05d9\u05d9? \u05d0\u05dd \u05dc\u05d0 \u05de\u05d0\u05e9\u05e8\u05d9\u05dd \u05dc\u05d9 \u05d0\u05ea \u05d4\u05e7\u05e6\u05d1\u05d4 \u05d4\u05d9\u05d5\u05dd, \u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d9\u05d5\u05e6\u05d0 \u05de\u05e4\u05d4. \u05e9\u05d9\u05d9\u05d2\u05de\u05e8 \u05d4\u05d1\u05dc\u05d2\u05df \u05d4\u05d6\u05d4. \u05ea\u05d1\u05d9\u05d0\u05d9 \u05de\u05d9 \u05e9\u05e6\u05e8\u05d9\u05da, \u05de\u05e0\u05d4\u05dc, \u05de\u05e0\u05db\"\u05dc, \u05de\u05d9 \u05e9\u05d6\u05d4 \u05dc\u05d0 \u05d9\u05d4\u05d9\u05d4, \u05db\u05d9 \u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d6\u05d6 \u05de\u05d4\u05db\u05d9\u05e1\u05d0 \u05d4\u05d6\u05d4 \u05e2\u05d3 \u05e9\u05de\u05d9\u05e9\u05d4\u05d5 \u05d9\u05d9\u05ea\u05df \u05dc\u05d9 \u05ea\u05e9\u05d5\u05d1\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea. \u05d5\u05d0\u05dd \u05e6\u05e8\u05d9\u05da, \u05d0\u05e0\u05d9 \u05d0\u05e2\u05e9\u05d4 \u05e4\u05d4 \u05d1\u05dc\u05d0\u05d2\u05df \u05e9\u05db\u05d5\u05dc\u05dd \u05d9\u05e9\u05de\u05e2\u05d5."
    },
    {
