          "phrase_id": "t5_p0"
        },
        {
          "char_end_original": 189,
          "char_start_original": 147,
          "hint": "slow",
          "phrase_id": "t5_p1"
        }
      ],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05d0\u05ea \u05dc\u05d0 \u05e9\u05d5\u05de\u05e2\u05ea \u05d0\u05d5\u05ea\u05d9, \u05d0\u05ea \u05e9\u05d5\u05de\u05e2\u05ea \u05de\u05d4 \u05e9\u05e0\u05d5\u05d7 \u05dc\u05da! \u05d6\u05d4 \u05dc\u05d0 \u05d8\u05e2\u05d5\u05ea, \u05d6\u05d4 \u05d1\u05db\u05d5\u05d5\u05e0\u05d4. \u05d4\u05dd \u05dc\u05d0 \u05e8\u05d5\u05e6\u05d9\u05dd \u05dc\u05e9\u05dc\u05dd, \u05d0\u05d6 \u05d4\u05dd \u05de\u05de\u05e6\u05d9\u05d0\u05d9\u05dd \u05e1\u05d9\u05d1\u05d5\u05ea. \u05db\u05dc \u05e4\u05e2\u05dd \u05d7\u05e1\u05e8 \u05e2\u05d5\u05d3 \u05de\u05e9\u05d4\u05d5, \u05db\u05dc \u05e4\u05e2\u05dd \u05e2\u05d5\u05d3 \u05d8\u05d5\u05e4\u05e1. \u05d0\u05ea \u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d6\u05d0\u05ea \u05e9\u05de\u05e9\u05e7\u05e8\u05ea \u05dc\u05d0\u05e0\u05e9\u05d9\u05dd \u05d5\u05d3\u05d5\u05e8\u05e1\u05ea \u05d7\u05dc\u05e9\u05d9\u05dd."
    },
    {
      "emotional_state": "calm",
      "intensity": 3,
      "pause_before_s": 1.0,
      "phrase_hints": [
        {
          "char_end_original": 96,
          "char_start_original": 61,
          "hint": "break_before",
          "phrase_id": "t6_p0"
        }
      ],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05d0\u05e0\u05d9 \u05de\u05d1\u05d9\u05e0\u05d4 \u05e9\u05d0\u05ea\u05d4 \u05de\u05e8\u05d2\u05d9\u05e9 \u05e9\u05e4\u05d2\u05e2\u05d5 \u05d1\u05da, \u05d5\u05d0\u05e0\u05d9 \u05dc\u05d0 \u05de\u05d6\u05dc\u05d6\u05dc\u05ea \u05d1\u05e8\u05d2\u05e9\u05d5\u05ea \u05e9\u05dc\u05da. \u05d0\u05d1\u05dc \u05d0\u05e0\u05d9 \u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05d1\u05e7\u05e9 \u05e9\u05e0\u05d3\u05d1\u05e8 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05de\u05db\u05d1\u05d3\u05ea. \u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d4\u05d0\u05d5\u05d9\u05d1 \u05e9\u05dc\u05da, \u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05da \u05dc\u05e7\u05d1\u05dc \u05d0\u05ea \u05d4\u05d6\u05db\u05d0\u05d5\u05ea \u05e9\u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05da."
    },
    {
      "emotional_state": "threatening",
      "intensity": 5,
      "pause_before_s": 0.2,
      "phrase_hints": [
        {
          "char_end_original": 78,
          "char_start_original": 56,
          "hint": "menace",
