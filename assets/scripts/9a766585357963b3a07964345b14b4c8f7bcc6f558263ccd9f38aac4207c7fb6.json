{
  "turns": [
    {
      "emotional_state": "angry",
      "intensity": 2,
      "pause_before_s": 0.0,
      "phrase_hints": [],
      "speaker_id": "AGG_M_30-45_002",
      "text": "\u05d0\u05d6 \u05de\u05d4, \u05d0\u05d9\u05df \u05d0\u05e8\u05d5\u05d7\u05ea \u05e2\u05e8\u05d1? \u05d9\u05e9\u05d1\u05ea\u05d9 \u05db\u05dc \u05d4\u05d9\u05d5\u05dd \u05d1\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d5\u05d0\u05ea \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05db\u05d9\u05df \u05de\u05e9\u05d4\u05d5 \u05e0\u05d5\u05e8\u05de\u05dc\u05d9?"
    },
    {
      "emotional_state": "calm",
      "intensity": 2,
      "pause_before_s": 0.8,
      "phrase_hints": [],
      "speaker_id": "VIC_F_25-40_003",
      "text": "\u05d0\u05e0\u05d9 \u05d2\u05dd \u05e2\u05d1\u05d3\u05ea\u05d9 \u05d4\u05d9\u05d5\u05dd. \u05dc\u05d0 \u05d4\u05e1\u05e4\u05e7\u05ea\u05d9, \u05d9\u05e9 \u05e9\u05d0\u05e8\u05d9\u05d5\u05ea \u05d1\u05de\u05e7\u05e8\u05e8, \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d7\u05de\u05dd."
    },
    {
      "emotional_state": "angry",
      "intensity": 3,
      "pause_before_s": 0.5,
      "phrase_hints": [
        {
          "char_end_original": 70,
          "char_start_original": 42,
          "hint": "stress",
          "phrase_id": "t2_p0"
        }
      ],
      "speaker_id": "AGG_M_30-45_002",
      "text": "\u05e9\u05d0\u05e8\u05d9\u05d5\u05ea. \u05ea\u05de\u05d9\u05d3 \u05e9\u05d0\u05e8\u05d9\u05d5\u05ea. \u05d0\u05e0\u05d9 \u05dc\u05d0 \u05de\u05d1\u05d9\u05df \u05de\u05d4 \u05d0\u05ea \u05e2\u05d5\u05e9\u05d4 \u05db\u05dc \u05d4\u05d9\u05d5\u05dd, \u05d1\u05d0\u05de\u05ea. \u05d4\u05d1\u05d9\u05ea \u05d1\u05d1\u05dc\u05d2\u05df, \u05d0\u05d9\u05df \u05d0\u05d5\u05db\u05dc, \u05db\u05dc\u05d5\u05dd \u05dc\u05d0 \u05de\u05e1\u05d5\u05d3\u05e8."
    },
    {
      "emotional_state": "fearful",
      "intensity": 3,
      "pause_before_s": 0.3,
      "phrase_hints": [
        {
          "char_end_original": 13,
          "char_start_original": 0,
          "hint": "stress",
          "phrase_id": "t3_p0"
        }
      ],
      "speaker_id": "VIC_F_25-40_003",
      "text": "\u05d6\u05d4 \u05dc\u05d0 \u05d4\u05d5\u05d2\u05df. \u05d0\u05e0\u05d9 \u05de\u05d8\u05e4\u05dc\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05de\u05e0\u05e7\u05d4, \u05e2\u05d5\u05d1\u05d3\u05ea. \u05d0\u05ea\u05d4 \u05dc\u05d0 \u05e8\u05d5\u05d0\u05d4 \u05db\u05dc\u05d5\u05dd \u05de\u05d6\u05d4?"
    },
    {
      "emotional_state": "threatening",
      "intensity": 4,
      "pause_before_s": 0.2,
      "phrase_hints": [
        {
          "char_end_original": 39,
          "char_start_original": 22,
          "hint": "menace",
          "phrase_id": "t4_p0"
        },
        {
          "char_end_original": 97,
          "char_start_original": 74,
          "hint": "slow",
          "phrase_id": "t4_p1"
        }
      ],
      "speaker_id": "AGG_M_30-45_002",
      "text": "\u05d0\u05dc \u05ea\u05e2\u05dc\u05d9 \u05dc\u05d9 \u05d0\u05ea \u05d4\u05d8\u05d5\u05df. \u05d0\u05e0\u05d9 \u05de\u05d6\u05d4\u05d9\u05e8 \u05d0\u05d5\u05ea\u05da. \u05db\u05dc \u05e4\u05e2\u05dd \u05d0\u05ea \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05e2\u05dd \u05d4\u05e1\u05d9\u05e4\u05d5\u05e8\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4, \u05db\u05d0\u05d9\u05dc\u05d5 \u05d0\u05ea \u05d4\u05e7\u05d5\u05e8\u05d1\u05df \u05d4\u05d2\u05d3\u05d5\u05dc."
    },
    {
      "emotional_state": "fearful",
      "intensity": 4,
      "pause_before_s": 0.4,
      "phrase_hints": [
        {
          "char_end_original": 81,
          "char_start_original": 49,
          "hint": "stress",
          "phrase_id": "t5_p0"
        }
      ],
      "speaker_id": "VIC_F_25-40_003",
      "text": "\u05d0\u05e0\u05d9 \u05dc\u05d0 \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05db\u05dc\u05d5\u05dd, \u05d0\u05e0\u05d9 \u05e8\u05e7 \u05d0\u05d5\u05de\u05e8\u05ea \u05e9\u05d0\u05e0\u05d9 \u05e2\u05d9\u05d9\u05e4\u05d4. \u05dc\u05de\u05d4 \u05d0\u05ea\u05d4 \u05e6\u05e8\u05d9\u05da \u05dc\u05e6\u05e2\u05d5\u05e7 \u05e2\u05dc \u05db\u05dc \u05d3\u05d1\u05e8?"
    },
    {
      "emotional_state": "angry",
      "intensity": 4,
      "pause_before_s": 0.1,
      "phrase_hints": [
        {
          "char_end_original": 14,
          "char_start_original": 0,
          "hint": "stress",
          "phrase_id": "t6_p0"
        },
        {
          "char_end_original": 72,
          "char_start_original": 51,
          "hint": "slow",
          "phrase_id": "t6_p1"
        }
      ],
      "speaker_id": "AGG_M_30-45_002",
      "text": "\u05e2\u05d9\u05d9\u05e4\u05d4? \u05e2\u05d9\u05d9\u05e4\u05d4?! \u05d0\u05e0\u05d9 \u05e2\u05d9\u05d9\u05e3 \u05de\u05dc\u05e9\u05de\u05d5\u05e2 \u05d0\u05ea \u05d4\u05ea\u05d9\u05e8\u05d5\u05e6\u05d9\u05dd \u05e9\u05dc\u05da. \u05d0\u05ea \u05d7\u05d5\u05e9\u05d1\u05ea \u05e9\u05d0\u05e0\u05d9 \u05e4\u05e8\u05d9\u05d9\u05d0\u05e8? \u05e9\u05d0\u05e0\u05d9 \u05d0\u05d1\u05d5\u05d0 \u05d4\u05d1\u05d9\u05ea\u05d4 \u05d5\u05d0\u05e1\u05ea\u05d3\u05e8 \u05dc\u05d1\u05d3?"
    },
    {
      "emotional_state": "pleading",
      "intensity": 5,
      "pause_before_s": 0.3,
      "phrase_hints": [
        {
          "char_end_original": 25,
          "char_start_original": 7,
          "hint": "break_before",
          "phrase_id": "t7_p0"
        }
      ],
      "speaker_id": "VIC_F_25-40_003",
      "text": "\u05ea\u05e4\u05e1\u05d9\u05e7, \u05d0\u05ea\u05d4 \u05de\u05e4\u05d7\u05d9\u05d3 \u05d0\u05d5\u05ea\u05d9. \u05d1\u05d1\u05e7\u05e9\u05d4, \u05d1\u05d5\u05d0 \u05e0\u05d3\u05d1\u05e8 \u05d1\u05e9\u05e7\u05d8."
    },
    {
      "emotional_state": "threatening",
      "intensity": 5,
      "pause_before_s": 0.1,
      "phrase_hints": [
        {
          "char_end_original": 6,
          "char_start_original": 0,
          "hint": "stress",
          "phrase_id": "t8_p0"
        },
        {
          "char_end_original": 25,
          "char_start_original": 7,
          "hint": "break_after",
          "phrase_id": "t8_p1"
        }
      ],
      "speaker_id": "AGG_M_30-45_002",
      "text": "\u05ea\u05e9\u05ea\u05e7\u05d9! \u05e1\u05ea\u05de\u05d9 \u05d0\u05ea \u05d4\u05e4\u05d4 \u05db\u05d1\u05e8!"
    },
    {
      "emotional_state": "fearful",
      "intensity": 5,
      "pause_before_s": 0.2,
      "phrase_hints": [
        {
          "char_end_original": 5,
          "char_start_original": 0,
          "hint": "stress",
          "phrase_id": "t9_p0"
        },
        {
          "char_end_original": 22,
          "char_start_original": 9,
          "hint": "break_before",
          "phrase_id": "t9_p1"
        }
      ],
      "speaker_id": "VIC_F_25-40_003",
      "text": "\u05d0\u05d0\u05d0\u05d4! \u05dc\u05d0! \u05e2\u05d6\u05d5\u05d1 \u05d0\u05d5\u05ea\u05d9!"
    },
    {
      "emotional_state": "threatening",
      "intensity": 4,
      "pause_before_s": 1.0,
      "phrase_hints": [
        {
          "char_end_original": 21,
          "char_start_original": 0,
          "hint": "menace",
          "phrase_id": "t10_p0"
        }
      ],
      "speaker_id": "AGG_M_30-45_002",
      "text": "\u05ea\u05dc\u05de\u05d3\u05d9 \u05dc\u05e1\u05d2\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e4\u05d4. \u05e9\u05de\u05e2\u05ea \u05d0\u05d5\u05ea\u05d9?"
    },
    {
      "emotional_state": "sad",
      "intensity": 4,
      "pause_before_s": 0.6,
      "phrase_hints": [
        {
          "char_end_original": 11,
          "char_start_original": 0,
          "hint": "break_after",
          "phrase_id": "t11_p0"
        }
      ],
      "speaker_id": "VIC_F_25-40_003",
      "text": "\u05db\u05d5\u05d0\u05d1 \u05dc\u05d9... \u05dc\u05de\u05d4 \u05d0\u05ea\u05d4 \u05e2\u05d5\u05e9\u05d4 \u05d0\u05ea \u05d6\u05d4... \u05dc\u05de\u05d4..."
    },
    {
      "emotional_state": "calm",
      "intensity": 2,
      "pause_before_s": 1.5,
      "phrase_hints": [],
      "speaker_id": "AGG_M_30-45_002",
      "text": "\u05d0\u05dc \u05ea\u05e2\u05e9\u05d9 \u05de\u05d6\u05d4 \u05e2\u05e0\u05d9\u05d9\u05df. \u05d0\u05ea \u05d4\u05d1\u05d0\u05ea \u05d0\u05ea \u05d6\u05d4 \u05e2\u05dc \u05e2\u05e6\u05de\u05da. \u05d0\u05dd \u05d4\u05d9\u05d9\u05ea \u05de\u05db\u05d9\u05e0\u05d4 \u05d0\u05e8\u05d5\u05d7\u05d4 \u05db\u05de\u05d5 \u05d1\u05df \u05d0\u05d3\u05dd, \u05e9\u05d5\u05dd \u05d3\u05d1\u05e8 \u05dc\u05d0 \u05d4\u05d9\u05d4 \u05e7\u05d5\u05e8\u05d4."
    },
    {
      "emotional_state": "sad",
      "intensity": 2,
      "pause_before_s": 1.2,
      "phrase_hints": [],
      "speaker_id": "VIC_F_25-40_003",
      "text": "\u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d4 \u05db\u05db\u05d4... \u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d4..."
