          "hint": "slow",
          "phrase_id": "t11_p1"
        }
      ],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05d0\u05e0\u05d9... \u05d0\u05e0\u05d9 \u05dc\u05d0 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05e4\u05d2\u05d5\u05e2 \u05d1\u05d0\u05e3 \u05d0\u05d7\u05d3. \u05d0\u05e0\u05d9 \u05e4\u05e9\u05d5\u05d8 \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc \u05d9\u05d5\u05ea\u05e8. \u05d0\u05e0\u05d9 \u05e9\u05dd \u05d0\u05ea \u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4. \u05d0\u05d1\u05dc \u05ea\u05e2\u05e9\u05d5 \u05de\u05e9\u05d4\u05d5, \u05d0\u05e0\u05d9 \u05de\u05ea\u05d7\u05e0\u05df."
    }
