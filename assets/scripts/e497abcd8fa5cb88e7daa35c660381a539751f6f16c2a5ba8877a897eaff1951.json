{
  "turns": [
    {
      "emotional_state": "angry",
      "intensity": 2,
      "pause_before_s": 0.0,
      "phrase_hints": [],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05ea\u05e9\u05de\u05e2\u05d9, \u05d0\u05e0\u05d9 \u05db\u05d1\u05e8 \u05e9\u05dc\u05d5\u05e9\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d7\u05db\u05d4 \u05dc\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e2\u05dc \u05d4\u05e2\u05e8\u05e2\u05d5\u05e8. \u05d0\u05e3 \u05d0\u05d7\u05d3 \u05dc\u05d0 \u05d7\u05d5\u05d6\u05e8 \u05d0\u05dc\u05d9\u05d9, \u05d0\u05e3 \u05d0\u05d7\u05d3 \u05dc\u05d0 \u05de\u05e1\u05d1\u05d9\u05e8 \u05dc\u05d9 \u05db\u05dc\u05d5\u05dd."
    },
    {
      "emotional_state": "calm",
      "intensity": 2,
      "pause_before_s": 0.3,
      "phrase_hints": [],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05d0\u05e0\u05d9 \u05de\u05d1\u05d9\u05e0\u05d4 \u05d0\u05ea \u05d4\u05ea\u05e1\u05db\u05d5\u05dc \u05e9\u05dc\u05da, \u05d1\u05df. \u05d0\u05e0\u05d9 \u05e8\u05d5\u05d0\u05d4 \u05d1\u05ea\u05d9\u05e7 \u05e9\u05d4\u05e2\u05e8\u05e2\u05d5\u05e8 \u05d4\u05d5\u05d2\u05e9 \u05d5\u05e9\u05d4\u05d5\u05d0 \u05e2\u05d3\u05d9\u05d9\u05df \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4. \u05dc\u05e4\u05e2\u05de\u05d9\u05dd \u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05dc\u05d5\u05e7\u05d7 \u05d6\u05de\u05df."
    },
    {
      "emotional_state": "angry",
      "intensity": 3,
      "pause_before_s": 0.2,
      "phrase_hints": [
        {
          "char_end_original": 62,
          "char_start_original": 38,
          "hint": "stress",
          "phrase_id": "t2_p0"
        },
        {
          "char_end_original": 98,
          "char_start_original": 63,
          "hint": "slow",
          "phrase_id": "t2_p1"
        }
      ],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\"\u05dc\u05d5\u05e7\u05d7 \u05d6\u05de\u05df\"? \u05d0\u05ea \u05de\u05d1\u05d9\u05e0\u05d4 \u05e9\u05d0\u05e0\u05d9 \u05d1\u05dc\u05d9 \u05db\u05e1\u05e3? \u05e9\u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc \u05dc\u05e9\u05dc\u05dd \u05e9\u05db\u05e8 \u05d3\u05d9\u05e8\u05d4? \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05dc\u05d9 \u05e8\u05e2\u05d1\u05d9\u05dd \u05d5\u05d0\u05ea \u05d0\u05d5\u05de\u05e8\u05ea \u05dc\u05d9 \"\u05dc\u05d5\u05e7\u05d7 \u05d6\u05de\u05df\"?"
    },
    {
      "emotional_state": "calm",
      "intensity": 2,
      "pause_before_s": 0.5,
      "phrase_hints": [],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05d0\u05e0\u05d9 \u05e9\u05d5\u05de\u05e2\u05ea \u05d0\u05d5\u05ea\u05da, \u05d5\u05d0\u05e0\u05d9 \u05de\u05d1\u05d9\u05e0\u05d4 \u05e9\u05d4\u05de\u05e6\u05d1 \u05e7\u05e9\u05d4 \u05de\u05d0\u05d5\u05d3. \u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05e2\u05d6\u05d5\u05e8, \u05d0\u05d1\u05dc \u05d0\u05d9\u05df \u05dc\u05d9 \u05e1\u05de\u05db\u05d5\u05ea \u05dc\u05d6\u05e8\u05d6 \u05d0\u05ea \u05d4\u05d5\u05d5\u05e2\u05d3\u05d4. \u05ea\u05df \u05dc\u05d9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05de\u05d4 \u05d0\u05e0\u05d9 \u05db\u05df \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea."
    },
    {
      "emotional_state": "threatening",
      "intensity": 3,
      "pause_before_s": 0.1,
      "phrase_hints": [
        {
          "char_end_original": 128,
          "char_start_original": 78,
          "hint": "menace",
          "phrase_id": "t4_p0"
        },
        {
          "char_end_original": 142,
          "char_start_original": 129,
          "hint": "break_after",
          "phrase_id": "t4_p1"
        }
      ],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05de\u05d4 \u05d0\u05ea \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea? \u05db\u05dc\u05d5\u05dd! \u05ea\u05de\u05d9\u05d3 \u05d0\u05d5\u05ea\u05d5 \u05d3\u05d1\u05e8 \u2014 \u05d8\u05e4\u05e1\u05d9\u05dd, \u05d4\u05de\u05ea\u05e0\u05d4, \u05d5\u05e2\u05d5\u05d3 \u05d4\u05de\u05ea\u05e0\u05d4. \u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d9\u05d5\u05e6\u05d0 \u05de\u05e4\u05d4 \u05d1\u05dc\u05d9 \u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05d9\u05d5\u05dd, \u05d0\u05ea \u05e9\u05d5\u05de\u05e2\u05ea \u05d0\u05d5\u05ea\u05d9? \u05dc\u05d0 \u05d9\u05d5\u05e6\u05d0 \u05de\u05e4\u05d4."
    },
    {
      "emotional_state": "fearful",
      "intensity": 3,
      "pause_before_s": 0.8,
      "phrase_hints": [
        {
          "char_end_original": 72,
          "char_start_original": 46,
          "hint": "break_before",
          "phrase_id": "t5_p0"
        }
      ],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05d1\u05df, \u05d0\u05e0\u05d9 \u05e8\u05d5\u05d0\u05d4 \u05e9\u05d0\u05ea\u05d4 \u05de\u05d0\u05d5\u05d3 \u05de\u05ea\u05d5\u05e1\u05db\u05dc \u05d5\u05d0\u05e0\u05d9 \u05dc\u05d0 \u05e8\u05d5\u05e6\u05d4 \u05e9\u05d4\u05de\u05e6\u05d1 \u05d9\u05e1\u05dc\u05d9\u05dd. \u05d0\u05e0\u05d9 \u05d4\u05d5\u05dc\u05db\u05ea \u05dc\u05e7\u05e8\u05d5\u05d0 \u05dc\u05de\u05e0\u05d4\u05dc\u05ea \u05e9\u05dc\u05d9, \u05d4\u05d9\u05d0 \u05d1\u05e2\u05dc\u05ea \u05e1\u05de\u05db\u05d5\u05ea \u05e8\u05d7\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05d0\u05d5\u05dc\u05d9 \u05ea\u05d5\u05db\u05dc \u05dc\u05ea\u05ea \u05dc\u05da \u05de\u05e2\u05e0\u05d4."
    },
    {
      "emotional_state": "angry",
      "intensity": 3,
      "pause_before_s": 0.2,
      "phrase_hints": [
        {
          "char_end_original": 51,
          "char_start_original": 22,
          "hint": "stress",
          "phrase_id": "t6_p0"
        }
      ],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05ea\u05e7\u05e8\u05d0\u05d9 \u05dc\u05de\u05d9 \u05e9\u05d0\u05ea \u05e8\u05d5\u05e6\u05d4. \u05de\u05d9\u05e9\u05d4\u05d5 \u05e4\u05d4 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05ea\u05ea \u05dc\u05d9 \u05ea\u05e9\u05d5\u05d1\u05d4."
    },
    {
      "emotional_state": "calm",
      "intensity": 2,
      "pause_before_s": 1.5,
      "phrase_hints": [],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05e8\u05d9\u05e0\u05d4, \u05d0\u05ea \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d1\u05d5\u05d0 \u05dc\u05e8\u05d2\u05e2? \u05d9\u05e9 \u05e4\u05d4 \u05de\u05e7\u05e8\u05d4 \u05d3\u05d7\u05d5\u05e3 \u05e9\u05d3\u05d5\u05e8\u05e9 \u05d0\u05ea \u05d4\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05e9\u05dc\u05da."
    },
    {
      "emotional_state": "calm",
      "intensity": 2,
      "pause_before_s": 0.5,
      "phrase_hints": [],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05d1\u05df, \u05d4\u05de\u05e0\u05d4\u05dc\u05ea \u05e9\u05dc\u05d9 \u05d1\u05d3\u05e8\u05da. \u05d4\u05d9\u05d0 \u05ea\u05d4\u05d9\u05d4 \u05db\u05d0\u05df \u05e2\u05d5\u05d3 \u05e8\u05d2\u05e2. \u05d1\u05d9\u05e0\u05ea\u05d9\u05d9\u05dd, \u05d1\u05d1\u05e7\u05e9\u05d4, \u05ea\u05e9\u05d1."
    },
    {
      "emotional_state": "angry",
      "intensity": 2,
      "pause_before_s": 0.4,
      "phrase_hints": [],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05e9\u05ea\u05d1\u05d5\u05d0. \u05d0\u05e0\u05d9 \u05de\u05d7\u05db\u05d4."
    },
    {
      "emotional_state": "calm",
      "intensity": 2,
      "pause_before_s": 1.2,
      "phrase_hints": [],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05e9\u05dc\u05d5\u05dd, \u05d0\u05e0\u05d9 \u05e8\u05d9\u05e0\u05d4 \u05d0\u05d1\u05e8\u05d4\u05dd, \u05de\u05e0\u05d4\u05dc\u05ea \u05d4\u05de\u05d7\u05dc\u05e7\u05d4. \u05d1\u05df, \u05e9\u05de\u05e2\u05ea\u05d9 \u05e9\u05d0\u05ea\u05d4 \u05de\u05de\u05ea\u05d9\u05df \u05db\u05d1\u05e8 \u05d6\u05de\u05df \u05e8\u05d1 \u05dc\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e2\u05dc \u05d4\u05e2\u05e8\u05e2\u05d5\u05e8. \u05d0\u05e0\u05d9 \u05de\u05e6\u05d8\u05e2\u05e8\u05ea \u05e2\u05dc \u05d4\u05e2\u05d9\u05db\u05d5\u05d1 \u05d5\u05d0\u05e0\u05d9 \u05dc\u05d5\u05e7\u05d7\u05ea \u05d0\u05ea \u05d6\u05d4 \u05d1\u05e8\u05e6\u05d9\u05e0\u05d5\u05ea."
    },
    {
      "emotional_state": "pleading",
      "intensity": 2,
      "pause_before_s": 0.3,
      "phrase_hints": [],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05db\u05df, \u05d2\u05d1\u05e8\u05ea. \u05e9\u05dc\u05d5\u05e9\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd. \u05d0\u05d9\u05df \u05dc\u05d9 \u05de\u05d0\u05d9\u05e4\u05d4 \u05dc\u05d7\u05d9\u05d5\u05ea. \u05d0\u05e0\u05d9 \u05dc\u05d0 \u05de\u05d1\u05e7\u05e9 \u05d8\u05d5\u05d1\u05d5\u05ea, \u05d0\u05e0\u05d9 \u05de\u05d1\u05e7\u05e9 \u05d0\u05ea \u05de\u05d4 \u05e9\u05de\u05d2\u05d9\u05e2 \u05dc\u05d9."
    },
    {
      "emotional_state": "calm",
      "intensity": 1,
      "pause_before_s": 0.5,
      "phrase_hints": [],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05d0\u05e0\u05d9 \u05de\u05d1\u05d9\u05e0\u05d4, \u05d5\u05d0\u05ea\u05d4 \u05e6\u05d5\u05d3\u05e7 \u05e9\u05d6\u05d4 \u05dc\u05d0 \u05ea\u05e7\u05d9\u05df \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05db\u05dc \u05db\u05da \u05d4\u05e8\u05d1\u05d4 \u05d6\u05de\u05df. \u05d0\u05e0\u05d9 \u05de\u05ea\u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05e2\u05e9\u05d5\u05ea \u05e9\u05e0\u05d9 \u05d3\u05d1\u05e8\u05d9\u05dd \u05e2\u05db\u05e9\u05d9\u05d5: \u05e8\u05d0\u05e9\u05d9\u05ea, \u05d0\u05e0\u05d9 \u05d1\u05d5\u05d3\u05e7\u05ea \u05d0\u05ea \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e9\u05dc \u05d4\u05e2\u05e8\u05e2\u05d5\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d0\u05ea\u05d4 \u05d9\u05d5\u05e6\u05d0 \u05de\u05d4\u05de\u05e9\u05e8\u05d3. \u05e9\u05e0\u05d9\u05ea, \u05d0\u05dd \u05d0\u05d9\u05df \u05d4\u05d7\u05dc\u05d8\u05d4 \u2014 \u05d0\u05e0\u05d9 \u05de\u05e2\u05d1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05ea\u05d9\u05e7 \u05e9\u05dc\u05da \u05dc\u05d3\u05d9\u05d5\u05df \u05de\u05d6\u05d5\u05e8\u05d6 \u05ea\u05d5\u05da \u05e9\u05d1\u05d5\u05e2."
    },
    {
      "emotional_state": "neutral",
      "intensity": 1,
      "pause_before_s": 0.3,
      "phrase_hints": [],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05ea\u05d5\u05da \u05e9\u05d1\u05d5\u05e2? \u05d1\u05d0\u05de\u05ea?"
    },
    {
      "emotional_state": "calm",
      "intensity": 1,
      "pause_before_s": 0.2,
      "phrase_hints": [],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05db\u05df, \u05ea\u05d5\u05da \u05e9\u05d1\u05d5\u05e2. \u05d0\u05e0\u05d9 \u05e8\u05d5\u05e9\u05de\u05ea \u05dc\u05da \u05d0\u05ea \u05d6\u05d4 \u05d1\u05db\u05ea\u05d1, \u05e2\u05dd \u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05dd \u05e9\u05dc \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05d9\u05e9\u05d9\u05e8. \u05d0\u05dd \u05e2\u05d3 \u05d9\u05d5\u05dd \u05e8\u05d0\u05e9\u05d5\u05df \u05d4\u05d1\u05d0 \u05dc\u05d0 \u05ea\u05e7\u05d1\u05dc \u05ea\u05e9\u05d5\u05d1\u05d4 \u2014 \u05ea\u05ea\u05e7\u05e9\u05e8 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d0\u05dc\u05d9\u05d9. \u05d4\u05e0\u05d4 \u05d4\u05db\u05e8\u05d8\u05d9\u05e1 \u05e9\u05dc\u05d9."
    },
    {
      "emotional_state": "sad",
      "intensity": 1,
      "pause_before_s": 0.5,
      "phrase_hints": [],
      "speaker_id": "BEN_M_40-55_003",
      "text": "\u05d8\u05d5\u05d1, \u05d0\u05e0\u05d9 \u05e1\u05d5\u05de\u05da \u05e2\u05dc\u05d9\u05da. \u05e1\u05dc\u05d9\u05d7\u05d4 \u05e9\u05d4\u05ea\u05e8\u05d2\u05d6\u05ea\u05d9, \u05d0\u05d1\u05dc \u05d1\u05d0\u05de\u05ea \u05d0\u05d9\u05df \u05dc\u05d9 \u05db\u05d5\u05d7 \u05d9\u05d5\u05ea\u05e8."
    },
    {
      "emotional_state": "calm",
      "intensity": 1,
      "pause_before_s": 0.3,
      "phrase_hints": [],
      "speaker_id": "SW_F_30-45_001",
      "text": "\u05d0\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05dc\u05d4\u05ea\u05e0\u05e6\u05dc, \u05d4\u05de\u05e6\u05d1 \u05e9\u05dc\u05da \u05e7\u05e9\u05d4 \u05d5\u05d0\u05e0\u05d7\u05e0\u05d5 \u05e4\u05d4 \u05db\u05d3\u05d9 \u05dc\u05e2\u05d6\u05d5\u05e8. \u05e0\u05d4\u05d9\u05d4 \u05d1\u05e7\u05e9\u05e8, \u05d1\u05df. \u05d9\u05d5\u05dd \u05d8\u05d5\u05d1."
    }
  ]
}
